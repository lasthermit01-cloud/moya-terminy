 void fill(){name.setText(f.name);updateColorButton();emoji.setText(f.emoji);opacity.setProgress(Math.max(0,f.opacity-30));shape.setSelection("circle".equals(f.shape)?2:"square".equals(f.shape)?1:0);previewCount.setSelection(f.previewCount==9?2:f.previewCount==6?1:0);showTitle.setChecked(f.showTitle);grid.setSelection(f.grid==5?2:f.grid==3?0:1);iconSize.setProgress(Math.max(0,f.iconSize-40));popupSize.setSelection("large".equals(f.popupSize)?2:"small".equals(f.popupSize)?0:1);anim.setSelection("fade".equals(f.animation)?1:"slide".equals(f.animation)?2:"spring".equals(f.animation)?3:"none".equals(f.animation)?4:0);glass.setChecked(f.glass);refreshApps();updatePreview();}
 void watch(){TextWatcher tw=new TextWatcher(){public void beforeTextChanged(CharSequence s,int st,int c,int a){}public void onTextChanged(CharSequence s,int st,int b,int c){captureLight();updatePreview();}public void afterTextChanged(Editable e){}};name.addTextChangedListener(tw);emoji.addTextChangedListener(tw);opacity.setOnSeekBarChangeListener(simpleSeek());shape.setOnItemSelectedListener(simpleSelect());previewCount.setOnItemSelectedListener(simpleSelect());showTitle.setOnCheckedChangeListener((b,c)->updatePreview());}
