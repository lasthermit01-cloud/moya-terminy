n(){if(colorButton==null)return;int c;try{c=Color.parseColor(f.color);}catch(Exception e){c=Color.rgb(108,99,255);}colorButton.setText("Обрати колір");colorButton.setBackground(Ui.round(this,c,14));double lum=(0.299*Color.red(c)+0.587*Color.green(c)+0.114*Color.blue(c));colorButton.setTextColor(lum>160?Color.BLACK:Color.WHITE);}
 void showColorPalette(){final int[] palette={0xFFF44336,0xFFE91E63,0xFF9C27B0,0xFF673AB7,0xFF3F51B5,0xFF2196F3,0xFF03A9F4,0xFF00BCD4,0xFF009688,0xFF4CAF50,0xFF8BC34A,0xFFCDDC39,0xFFFFEB3B,0xFFFFC107,0xFFFF9800,0xFFFF5722,0xFF795548,0xFF9E9E9E,0xFF607D8B,0xFF111218,0xFFFFFFFF,0xFF6C63FF,0xFFD98CB3,0xFF78C7C7,0xFF9CCB7A,0xFFF5A65B,0xFF536DFE,0xFF7E57C2,0xFF26A69A,0xFFEC407A};GridLayout g=new GridLayout(this);g.setColumnCount(5);g.setPadding(Ui.dp(this,12),Ui.dp(this,12),Ui.dp(this,12),Ui.dp(this,12));for(int c:palette){TextView chip=new TextView(this);chip.setText("");chip.setBackground(Ui.round(this,c,16));GridLayout.LayoutParams lp=new GridLayout.LayoutParams();lp.width=Ui.dp(this,50);lp.height=Ui.dp(this,50);lp.setMargins(Ui.dp(this,5),Ui.dp(this,5),Ui.dp(this,5),Ui.dp(this,5));chip.setLayoutParams(lp);chip.setOnClickListener(v->{f.color=String.format(Locale.US,"#%06X",(0xFFFFFF&c));updateColorButton();updatePreview();Dialog d=(Dialog)v.getTag();if(d!=null)d.dismiss();});g.addView(chip);}AlertDialog d=new AlertDialog.Builder(this).setTitle("Колір папки").setView(g).setNegativeButton("Скасувати",null).create();for(int i=0;i<g.getChildCount();i++)g.getChildAt(i).setTag(d);d.show();}
 String[] templateNames(){JSONArray a=store.templates();String[] out=new String[a.length()+1];out[0]="Оберіть шаблон";for(int i=0;i<a.length();i++)out[i+1]=a.optJSONObject(i).optString("templateName","Шаблон "+(i+1));return out;}
 void applyTemplate(int idx){if(idx<0)return;JSONObject o=store.templates().optJSONObject(idx);if(o==null)return;ArrayList<String> keep=new ArrayList<>(f.packages);long id=f.id;f=FolderStore.Folder.from(o);f.id=id;f.packages.addAll(keep);fill();}
 void saveTemplate(){final EditText e=Ui.input(this,"Назва шаблону");new AlertDialog.Builder(this).setTitle("Зберегти шаблон").setView(e).setNegativeButton("Скасувати",null).setPositiveButton("Зберегти",(d,w)->{capture();String n=e.getText().toString().trim();if(n.isEmpty())n="Мій шаблон";store.saveTemplate(n,f);Toast.makeText(this,"Шаблон збережено",Toast.LENGTH_SHORT).show();}).show();}
 void pinWidget(){if(Build.VERSION.SDK_INT>=26){AppWidgetManager m=AppWidgetManager.getInstance(this);ComponentName p=new ComponentName(this,FolderWidgetProvider.class);if(m.isRequestPinAppWidgetSupported()){getSharedPreferences("settings",0).edit().putLong("pending_pin",f.id).apply();Intent callbackIntent=new Intent(this,PinSuccessReceiver.class).putExtra("folderId",f.id).setAction("com.customfolders.app.PIN."+f.id+"."+System.currentTimeMillis());PendingIntent callback=PendingIntent.getBroadcast(this,(int)(f.id&0x7fffffff),callbackIntent,PendingIntent.FLAG_UPDATE_CURRENT|PendingIntent.FLAG_IMMUTABLE);m.requestPinAppWidget(p,null,callback);Toast.makeText(this,"Підтвердь додавання на робочий стіл",Toast.LENGTH_LONG).show();return;}}Toast.makeText(this,"Додай віджет через меню віджетів HyperOS",Toast.LENGTH_LONG).show();}
}
