s().heightPixels*.84));}
 class AppAdapter extends BaseAdapter{ArrayList<AppInfo> data=new ArrayList<>();String query="";boolean system=false;AppAdapter(List<AppInfo>a,boolean s){filter("",s);}void filter(String q,boolean sys){query=q.toLowerCase(Locale.ROOT);system=sys;data.clear();for(AppInfo a:installed)if((sys||!a.system)&&a.label.toLowerCase(Locale.ROOT).contains(query))data.add(a);notifyDataSetChanged();}public int getCount(){return data.size();}public Object getItem(int p){return data.get(p);}public long getItemId(int p){return p;}public View getView(int p,View v,android.view.ViewGroup parent){AppInfo a=data.get(p);LinearLayout row=new LinearLayout(EditorActivity.this);row.setGravity(Gravity.CENTER_VERTICAL);row.setPadding(Ui.dp(EditorActivity.this,6),Ui.dp(EditorActivity.this,5),Ui.dp(EditorActivity.this,6),Ui.dp(EditorActivity.this,5));ImageView im=new ImageView(EditorActivity.this);im.setImageDrawable(a.icon);row.addView(im,new LinearLayout.LayoutParams(Ui.dp(EditorActivity.this,42),Ui.dp(EditorActivity.this,42)));TextView t=Ui.text(EditorActivity.this,a.label,15,ThemeUtils.text(EditorActivity.this));LinearLayout.LayoutParams tp=new LinearLayout.LayoutParams(0,-2,1);Ui.margins(tp,EditorActivity.this,9,0,0,0);row.addView(t,tp);CheckBox c=new CheckBox(EditorActivity.this);c.setChecked(f.packages.contains(a.pkg));c.setOnCheckedChangeListener((b,ch)->{if(ch&&!f.packages.contains(a.pkg))f.packages.add(a.pkg);else if(!ch)f.packages.remove(a.pkg);});row.addView(c,new LinearLayout.LayoutParams(-2,-2));return row;}}
 void refreshApps(){if(appsBox==null)return;appsBox.removeAllViews();PackageManager pm=getPackageManager();for(int i=0;i<f.packages.size();i++){String pkg=f.packages.get(i);String lab=pkg;Drawable ic=null;try{ApplicationInfo ai=pm.getApplicationInfo(pkg,0);lab=pm.getApplicationLabel(ai).toString();ic=pm.getApplicationIcon(ai);}catch(Exception ignored){}LinearLayout row=new LinearLayout(this);row.setGravity(Gravity.CENTER_VERTICAL);if(ic!=null){ImageView iv=new ImageView(this);iv.setImageDrawable(ic);row.addView(iv,new LinearLayout.LayoutParams(Ui.dp(this,36),Ui.dp(this,36)));}TextView t=Ui.text(this,lab,14,ThemeUtils.text(this));LinearLayout.LayoutParams tp=new LinearLayout.LayoutParams(0,-2,1);Ui.margins(tp,this,8,0,0,0);row.addView(t,tp);Button up=Ui.button(this,"↑",false),down=Ui.button(this,"↓",false),del=Ui.button(this,"×",false);row.addView(up,new LinearLayout.LayoutParams(Ui.dp(this,43),Ui.dp(this,40)));row.addView(down,new LinearLayout.LayoutParams(Ui.dp(this,43),Ui.dp(this,40)));row.addView(del,new LinearLayout.LayoutParams(Ui.dp(this,43),Ui.dp(this,40)));final int idx=i;up.setOnClickListener(v->{if(idx>0){Collections.swap(f.packages,idx,idx-1);refreshApps();updatePreview();}});down.setOnClickListener(v->{if(idx<f.packages.size()-1){Collections.swap(f.packages,idx,idx+1);refreshApps();updatePreview();}});del.setOnClickListener(v->{f.packages.remove(idx);refreshApps();updatePreview();});appsBox.addView(row,Ui.mp(this));}}
 void applyPreset(int p){if(p==1){f.color="#DDEBFF";f.opacity=150;f.shape="rounded";f.emoji="◈";f.glass=true;}else if(p==2){f.color="#2D2F36";f.opacity=245;f.shape="rounded";f.emoji="";f.glass=false;}else if(p==3){f.color="#6A00FF";f.opacity=235;f.shape="rounded";f.emoji="✦";f.glass=false;}else if(p==4){f.color="#111218";f.opacity=245;f.shape="rounded";f.emoji="●";f.glass=true;}else if(p==5){f.color="#D98CB3";f.opacity=220;f.shape="rounded";f.emoji="✿";f.glass=false;}fill();}
