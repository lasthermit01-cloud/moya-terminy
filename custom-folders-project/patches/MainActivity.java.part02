8),Ui.dp(this,46)));c.addView(row,Ui.mp(this));LinearLayout.LayoutParams cp=Ui.mp(this);Ui.margins(cp,this,0,5,0,7);list.addView(c,cp);c.setOnClickListener(v->{Intent i=new Intent(this,EditorActivity.class).putExtra("folderId",f.id);startActivity(i);});more.setOnClickListener(v->menu(f));}}
 void menu(FolderStore.Folder f){String[] x={"Відкрити","Додати на робочий стіл","Дублювати","Видалити"};new AlertDialog.Builder(this).setTitle(f.name).setItems(x,(d,w)->{if(w==0)startActivity(new Intent(this,FolderPopupActivity.class).putExtra("folderId",f.id));else if(w==1)pin(f.id);else if(w==2){store.duplicate(f.id);refresh();}else new AlertDialog.Builder(this).setTitle("Видалити папку?").setMessage("Програми не видаляються — лише ця папка та її налаштування.").setNegativeButton("Скасувати",null).setPositiveButton("Видалити",(a,b)->{store.delete(f.id);FolderWidgetProvider.updateAll(this);refresh();}).show();}).show();}
 void pin(long id){if(Build.VERSION.SDK_INT>=26){android.appwidget.AppWidgetManager m=android.appwidget.AppWidgetManager.getInstance(this);ComponentName p=new ComponentName(this,FolderWidgetProvider.class);if(m.isRequestPinAppWidgetSupported()){getSharedPreferences("settings",0).edit().putLong("pending_pin",id).apply();Intent callbackIntent=new Intent(this,PinSuccessReceiver.class).putExtra("folderId",id).setAction("com.customfolders.app.PIN."+id+"."+System.currentTimeMillis());android.app.PendingIntent callback=android.app.PendingIntent.getBroadcast(this,(int)(id&0x7fffffff),callbackIntent,android.app.PendingIntent.FLAG_UPDATE_CURRENT|android.app.PendingIntent.FLAG_IMMUTABLE);m.requestPinAppWidget(p,null,callback);Toast.makeText(this,"Підтвердь додавання віджета на робочий стіл",Toast.LENGTH_LONG).show();return;}}Toast.makeText(this,"Додай віджет «Мої папки» через меню віджетів лаунчера",Toast.LENGTH_LONG).show();}
 String labelAnim(String s){if("fade".equals(s))return"Fade";if("slide".equals(s))return"Slide Up";if("spring".equals(s))return"Spring";if("none".equals(s))return"Без анімації";return"Zoom";}
}
