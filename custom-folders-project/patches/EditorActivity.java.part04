tSize(14);return c;}void label(LinearLayout r,String s){TextView t=Ui.text(this,s,13,ThemeUtils.sub(this));LinearLayout.LayoutParams p=Ui.mp(this);Ui.margins(p,this,1,9,0,4);r.addView(t,p);}void section(LinearLayout r,String s){TextView t=Ui.text(this,s,15,ThemeUtils.text(this));t.setTypeface(android.graphics.Typeface.DEFAULT_BOLD);LinearLayout.LayoutParams p=Ui.mp(this);Ui.margins(p,this,0,18,0,7);r.addView(t,p);}
 void pickImage(int req){Intent i=new Intent(Intent.ACTION_GET_CONTENT);i.setType("image/*");i.addCategory(Intent.CATEGORY_OPENABLE);startActivityForResult(Intent.createChooser(i,"Оберіть зображення"),req);}
 @Override protected void onActivityResult(int req,int result,Intent data){super.onActivityResult(req,result,data);if(result!=RESULT_OK||data==null||data.getData()==null)return;Uri u=data.getData();String saved=copyImageIntoApp(u,req==REQ_BG?"background":"icon");if(saved==null){Toast.makeText(this,"Не вдалося прочитати зображення",Toast.LENGTH_SHORT).show();return;}if(req==REQ_BG)f.bgUri=saved;else if(req==REQ_ICON)f.iconUri=saved;updatePreview();}
 String copyImageIntoApp(Uri source,String prefix){try{File dir=new File(getFilesDir(),"folder_images");if(!dir.exists()&&!dir.mkdirs())return null;File out=new File(dir,prefix+"_"+System.currentTimeMillis()+".img");try(InputStream in=getContentResolver().openInputStream(source);OutputStream os=new FileOutputStream(out)){if(in==null)return null;byte[] buf=new byte[16384];int n;while((n=in.read(buf))>0)os.write(buf,0,n);}return Uri.fromFile(out).toString();}catch(Exception e){return null;}}
 void loadApps(){PackageManager pm=getPackageManager();Intent i=new Intent(Intent.ACTION_MAIN);i.addCategory(Intent.CATEGORY_LAUNCHER);HashSet<String> seen=new HashSet<>();for(ResolveInfo r:pm.queryIntentActivities(i,0)){String p=r.activityInfo.packageName;if(seen.add(p)){ApplicationInfo ai=r.activityInfo.applicationInfo;installed.add(new AppInfo(p,r.loadLabel(pm).toString(),r.loadIcon(pm),(ai.flags&ApplicationInfo.FLAG_SYSTEM)!=0));}}installed.sort(Comparator.comparing(a->a.label.toLowerCase(Locale.ROOT)));}
 void showAppPicker(){Dialog d=new Dialog(this);LinearLayout root=new LinearLayout(this);root.setOrientation(LinearLayout.VERTICAL);root.setPadding(Ui.dp(this,14),Ui.dp(this,14),Ui.dp(this,14),Ui.dp(this,14));root.setBackgroundColor(ThemeUtils.bg(this));EditText q=Ui.input(this,"Пошук програм…");q.setSingleLine(true);root.addView(q,new LinearLayout.LayoutParams(-1,Ui.dp(this,50)));CheckBox sys=check("Показувати системні програми");root.addView(sys,Ui.mp(this));ListView lv=new ListView(this);AppAdapter ad=new AppAdapter(installed,false);lv.setAdapter(ad);root.addView(lv,new LinearLayout.LayoutParams(-1,0,1));Button done=Ui.button(this,"Готово",true);root.addView(done,new LinearLayout.LayoutParams(-1,Ui.dp(this,50)));d.setContentView(root);Window w=d.getWindow();if(w!=null)w.setLayout(-1,(int)(getResources().getDisplayMetrics().heightPixels*.82));q.addTextChangedListener(new TextWatcher(){public void beforeTextChanged(CharSequence s,int a,int b,int c){}public void onTextChanged(CharSequence s,int a,int b,int c){ad.filter(s.toString(),sys.isChecked());}public void afterTextChanged(Editable e){}});sys.setOnCheckedChangeListener((b,c)->ad.filter(q.getText().toString(),c));done.setOnClickListener(v->{d.dismiss();refreshApps();updatePreview();});d.show();if(d.getWindow()!=null)d.getWindow().setLayout((int)(getResources().getDisplayMetrics().widthPixels*.94),(int)(getResources().getDisplayMetric